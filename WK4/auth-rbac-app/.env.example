# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
DB_PATH=data/app.db
SESSION_TTL_MINUTES=120

# Admin account seeded on first start (self-registration always creates role "user").
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Set to true when deployed behind HTTPS (Render, Railway, Fly...). Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
# Set to true behind a reverse proxy so rate limiting sees the real client IP.
# TRUST_PROXY=true

LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=50
LOGIN_WINDOW_MINUTES=15
